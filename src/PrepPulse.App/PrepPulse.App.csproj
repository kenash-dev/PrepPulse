<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF and WinForms share type names (Application, Button, Color...), so usings are explicit in this project. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PrepPulse</AssemblyName>
    <RootNamespace>PrepPulse.App</RootNamespace>
    <StartupObject>PrepPulse.App.Program</StartupObject>
    <Product>PrepPulse</Product>
    <!-- A tray app: no background GC thread, and let the GC trade a little CPU for a smaller heap. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- 0-9; higher compacts more aggressively to keep the heap small. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generic Host (background services, DI) and Kestrel for the on-demand dashboard. Part of the shared framework, no NuGet. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrepPulse.Core\PrepPulse.Core.csproj" />
    <ProjectReference Include="..\PrepPulse.Data\PrepPulse.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\web\**\*" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\examples\plans\*.yaml" Link="seed\plans\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
